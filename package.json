{
  "name": "aegix",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIX — On-Chain Privacy Intelligence for Solana",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev": "pnpm -r --parallel run dev",
    "test:wallets": "node --import tsx tests/golden-wallets.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
