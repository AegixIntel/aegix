{
  "name": "aegix",
  "version": "0.1.0",
  "private": true,
  "description": "AEGIX — On-Chain Privacy Intelligence for Solana",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run build && pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "node --import tsx --test 'tests/helpers/*.test.ts' && pnpm -r run test",
    "test:integration": "pnpm --filter @aegix/api test:integration",
    "test:queue-integration": "node --import tsx tests/queue-integration.ts",
    "dev": "pnpm -r --parallel run dev",
    "test:wallets": "node --import tsx tests/golden-user-wallets-deterministic.ts",
    "test:wallets:live": "node --import tsx tests/golden-user-wallets.ts",
    "test:account-classification": "node --import tsx tests/golden-account-classification.ts",
    "test:monitors": "node --import tsx tests/golden-monitors.ts",
    "test:correlation": "node --import tsx tests/golden-correlation.ts",
    "test:correlation-dataset": "node --import tsx tests/golden-correlation-dataset.ts",
    "test:correlation-block2": "node --import tsx tests/e2e-correlation-block2.ts",
    "test:e2e-monitor": "node --import tsx tests/e2e-monitor.ts",
    "test:e2e-d5": "node --import tsx tests/e2e-d5.ts",
    "test:e2e-d6-block1": "node --import tsx tests/e2e-d6-block1.ts",
    "test:e2e-d6-block2": "node --import tsx tests/e2e-d6-block2.ts",
    "test:e2e-d6": "node --import tsx tests/e2e-d6.ts",
    "test:e2e-d7": "node --import tsx tests/e2e-d7.ts",
    "test:migrations": "node --import tsx tests/migration-test.ts",
    "test:web-routing": "node --import tsx tests/web-routing-smoke.ts",
    "release:gate": "bash scripts/release-gate.sh",
    "loadtest:analysis": "node --import tsx tests/load-test.ts",
    "loadtest:correlation": "node --import tsx tests/load-test-correlation.ts",
    "loadtest:monitors": "node --import tsx tests/load-test-monitors.ts",
    "loadtest:public": "node --import tsx tests/load-test-public.ts",
    "verify:programs": "node --import tsx scripts/verify-programs.ts"
  },
  "devDependencies": {
    "@aegix/blockchain": "workspace:*",
    "@aegix/cache": "workspace:*",
    "@aegix/config": "workspace:*",
    "@aegix/correlation": "workspace:*",
    "@aegix/database": "workspace:*",
    "@aegix/diff": "workspace:*",
    "@aegix/graph": "workspace:*",
    "@aegix/logging": "workspace:*",
    "@aegix/commonality": "workspace:*",
    "@aegix/webhook-delivery": "workspace:*",
    "@aegix/monitor": "workspace:*",
    "@aegix/queue": "workspace:*",
    "@aegix/types": "workspace:*",
    "@noble/curves": "^1.9.7",
    "bs58": "^6.0.0",
    "bullmq": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
