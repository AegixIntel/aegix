{
  "name": "@aegix/monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@aegix/config": "workspace:*",
    "@aegix/database": "workspace:*",
    "@aegix/diff": "workspace:*",
    "@aegix/logging": "workspace:*",
    "@aegix/queue": "workspace:*",
    "@aegix/types": "workspace:*",
    "@aegix/webhook-delivery": "workspace:^",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
