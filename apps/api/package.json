{
  "name": "@aegix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/developer-keys.test.ts src/notification-cursor.test.ts src/server.test.ts src/wallet-auth.test.ts src/wallet-context.test.ts src/ask-aegix.test.ts src/markets.test.ts src/billing.test.ts",
    "test:integration": "node --import tsx --test src/developer-api.test.ts src/notifications.integration.test.ts",
    "test:email:optional": "node --import tsx --test src/notification-email.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aegix/ai": "workspace:*",
    "@aegix/billing": "workspace:*",
    "@aegix/blockchain": "workspace:*",
    "@aegix/cache": "workspace:*",
    "@aegix/commonality": "workspace:^",
    "@aegix/config": "workspace:*",
    "@aegix/context": "workspace:*",
    "@aegix/correlation": "workspace:^",
    "@aegix/database": "workspace:*",
    "@aegix/explanation": "workspace:^",
    "@aegix/graph": "workspace:*",
    "@aegix/logging": "workspace:*",
    "@aegix/markets": "workspace:*",
    "@aegix/monitor": "workspace:^",
    "@aegix/queue": "workspace:*",
    "@aegix/types": "workspace:*",
    "@aegix/webhook-delivery": "workspace:^",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.0",
    "@noble/curves": "^1.9.7",
    "bs58": "^6.0.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
