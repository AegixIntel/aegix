{
  "name": "@aegix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aegix/blockchain": "workspace:*",
    "@aegix/cache": "workspace:*",
    "@aegix/config": "workspace:*",
    "@aegix/database": "workspace:*",
    "@aegix/explanation": "workspace:^",
    "@aegix/logging": "workspace:*",
    "@aegix/queue": "workspace:*",
    "@aegix/types": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.0",
    "fastify": "^5.2.0",
    "jose": "^6.2.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
