{
  "name": "@aegix/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "healthcheck": "node dist/healthcheck.js",
    "queue-status": "node dist/queue-status.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aegix/network": "workspace:*",
    "@aegix/billing": "workspace:*",
    "@aegix/blockchain": "workspace:*",
    "@aegix/commonality": "workspace:^",
    "@aegix/config": "workspace:*",
    "@aegix/correlation": "workspace:*",
    "@aegix/database": "workspace:*",
    "@aegix/explanation": "workspace:^",
    "@aegix/graph": "workspace:*",
    "@aegix/intelligence": "workspace:*",
    "@aegix/logging": "workspace:*",
    "@aegix/monitor": "workspace:*",
    "@aegix/normalizer": "workspace:*",
    "@aegix/queue": "workspace:*",
    "@aegix/scoring": "workspace:*",
    "@aegix/types": "workspace:*",
    "@aegix/webhook-delivery": "workspace:^",
    "bullmq": "^5.34.7",
    "@aegix/markets": "workspace:*",
    "@aegix/rewind": "workspace:*",
    "@aegix/discovery": "workspace:*",
    "@aegix/sources": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
