# AEGIX environment configuration
# Copy to .env and adjust for your environment. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info
PORT=3001

DATABASE_URL=postgres://postgres:postgres@localhost:5432/aegix
REDIS_URL=redis://localhost:6379

RPC_URL=https://api.mainnet-beta.solana.com
RPC_RATE_LIMIT_PER_SECOND=100

JWT_SECRET=replace-with-a-long-random-secret

CORS_ORIGIN=http://localhost:3000

# D4: privacy threat monitor (see docs/milestone-d4.md)
ENABLE_MONITORING=true
ENABLE_MONITOR_SCHEDULER=true
ENABLE_EMAIL_NOTIFICATIONS=false
MONITOR_ALLOWED_SCHEDULES=DAILY,EVERY_12_HOURS,EVERY_6_HOURS
MONITOR_DEFAULT_SCHEDULE=DAILY
MAX_ACTIVE_MONITORS_PER_USER=3
MAX_MONITOR_JOBS_PER_HOUR=120
MAX_ACTIVE_MONITOR_JOBS=10
MAX_MONITOR_QUEUE_DEPTH=100
MONITOR_EVENT_COOLDOWN_HOURS=24
MONITOR_MIN_CONFIDENCE=0.6
MONITOR_SCORE_DELTA_THRESHOLD=10
