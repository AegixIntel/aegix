# AEGIX environment configuration
# Copy to .env and adjust for your environment. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aegix

# Redis
REDIS_URL=redis://localhost:6379

# Solana RPC — primary URL (required for production)
RPC_URL=https://api.mainnet-beta.solana.com
RPC_RATE_LIMIT_PER_SECOND=100

# RPC failover (optional): configure secondary/tertiary providers for resilience.
# The provider pool uses circuit-breaker pattern: after RPC_CIRCUIT_FAILURE_THRESHOLD
# consecutive failures, a provider is cooled down for RPC_CIRCUIT_COOLDOWN_MS.
# RPC_PRIMARY_URL=https://api.mainnet-beta.solana.com
# RPC_PRIMARY_NAME=Mainnet Beta
# RPC_SECONDARY_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_SECONDARY_NAME=Alchemy
# RPC_TERTIARY_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# RPC_TERTIARY_NAME=Helius
RPC_CIRCUIT_FAILURE_THRESHOLD=5
RPC_CIRCUIT_COOLDOWN_MS=30000
RPC_MAX_RETRIES=2

# Authentication (wallet-only; production values must be the same HTTPS origin)
AUTH_DOMAIN=http://localhost:3000
AUTH_APP_URI=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Reverse-proxy hops trusted for the client IP (global rate limit, per-IP
# admission, anonymous quota). 0 uses the socket address. Behind the production
# nginx proxy this must be 1, or every visitor shares one set of limits.
TRUST_PROXY_HOPS=0

# Webhook delivery (production requires a 32+ char encryption key)
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_DEV_ALLOW_PRIVATE=false
WEBHOOK_ALLOWED_PORTS=80,443
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_DISABLE_AFTER_FAILURES=10

# Public beta notifications are website-only. Email/SMTP is dormant backend
# compatibility code, out of scope, and must stay disabled.
EMAIL_ENABLED=false
ENABLE_EMAIL_NOTIFICATIONS=false

# Privacy threat monitor
ENABLE_MONITORING=true
ENABLE_MONITOR_SCHEDULER=true
MONITOR_ALLOWED_SCHEDULES=DAILY,EVERY_12_HOURS,EVERY_6_HOURS
MONITOR_DEFAULT_SCHEDULE=DAILY
MAX_ACTIVE_MONITORS_PER_USER=3
MAX_MONITOR_JOBS_PER_HOUR=120
MAX_ACTIVE_MONITOR_JOBS=10
MAX_MONITOR_QUEUE_DEPTH=100
MONITOR_EVENT_COOLDOWN_HOURS=24
MONITOR_MIN_CONFIDENCE=0.6
MONITOR_SCORE_DELTA_THRESHOLD=10

# Billing / entitlements (D11). The free plan is defined as the limits
# already set above (FREE_USER_DAILY_LIMIT, MAX_ACTIVE_MONITORS_PER_USER, …),
# so enabling billing changes nothing for an identity without a subscription.
# This baseline ships no payment provider: paid plans are granted by an
# operator with `pnpm billing:grant`.
ENABLE_BILLING=true
BILLING_PROVIDER=manual
BILLING_CURRENCY=USD
BILLING_TRIAL_DAYS=0
BILLING_GRACE_DAYS=7
MAX_ACTIVE_WEBHOOKS_PER_USER=5

# Rewind and Discovery Engine (D14). All default off. Start capture first: a
# replay reaches back only to the first stored capture, and the Discovery
# Engine tests nothing until the ledger holds 14 days of hourly observations.
ENABLE_REWIND_CAPTURE=false
ENABLE_REWIND=false
ENABLE_DISCOVERY=false
# The daily-resolution scan reads series that only move in market sessions
# (options, sector and commodity funds). It tests nothing until a series has
# about four months of daily observations.
ENABLE_DISCOVERY_DAILY=false
# Publishes the head of the Discovery ID chain to public OpenTimestamps
# calendars (one 32-byte hash each), so a detection time can be proved to a
# third party.
ENABLE_DISCOVERY_ANCHOR=false
REWIND_CAPTURE_INTERVAL_SECONDS=900
# Series sources for the ledger, each opt-in. Tokenized stocks are read from
# RPC_URL (two calls per sweep). Narrative is GDELT's public API. Options is
# Cboe's delayed website feed and carries no redistribution licence.
ENABLE_TOKENIZED_STOCK_CAPTURE=false
ENABLE_NARRATIVE_CAPTURE=false
# A second narrative reading, from GDELT's Context 2.0 index: mentions per hour.
ENABLE_NARRATIVE_CONTEXT_CAPTURE=false
ENABLE_OPTIONS_CAPTURE=false
# Sector and commodity fund prices, from the same Cboe delayed feed as options
# and with the same standing: no redistribution licence.
ENABLE_SECTOR_CAPTURE=false
# Stores what news coverage and the funds were doing as signal captures, so
# Rewind can replay them. Reads the two sources above; captures from then on.
ENABLE_CONTEXT_SIGNAL_CAPTURE=false
# D15 market intelligence engines (docs/milestone-d15-market-intelligence-engines.md).
# The capture stores an anomaly reading per series per hour, from then on.
ENABLE_ANOMALY_CAPTURE=false
# Read APIs and pages. Each reads what the ledger and the captures hold.
ENABLE_ANOMALY_DETECTION=false
ENABLE_NARRATIVE_RADAR=false
ENABLE_SIGNAL_ENGINE=false
ENABLE_CROSS_MARKET=false

# Feature flags
ENABLE_NEW_ANALYSES=true
ENABLE_SAVED_COMPARISONS=true
ENABLE_DEVELOPER_API=true
ENABLE_WEBHOOK_DELIVERY=true
ENABLE_CORRELATION_ANALYSIS=true
ENABLE_POPULATION_COMMONALITY=false

# Required only for destructive local/CI test databases. Never set in a
# production service environment.
# AEGIX_ALLOW_TEST_DB_RESET=true

# Optional network ingestion CLI: pnpm --filter @aegix/network indexer
# Set explicitly when running it; the API/worker do not start this process.
# INDEXER_CHAIN=solana:mainnet
# INDEXER_RPC_URL=https://your-archive-rpc.example
# Several independent providers rotate on failure. Prefer this over the single
# URL: one provider outage otherwise stalls ingestion until it recovers.
# INDEXER_RPC_URLS=https://primary.example,https://secondary.example
# INDEXER_START_HEIGHT=0
# INDEXER_BATCH_SIZE=32
# INDEXER_POLL_MS=2000
# INDEXER_RPC_MIN_INTERVAL_MS=200
# INDEXER_RPC_TIMEOUT_MS=30000
# INDEXER_RPC_MAX_ATTEMPTS=2
# INDEXER_RPC_COOLDOWN_MS=30000
# INDEXER_VERIFY_EVERY_BATCHES=60
# ENABLE_NETWORK_API=true
# ENABLE_INDEXED_TRANSACTIONS=true
# REPUTATION_POLICY_FILE=/run/secrets/reputation-policy.json
# EVM alternatives: INDEXER_CHAIN=eip155:1 or eip155:8453
